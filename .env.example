APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# S3 upload mode only (UPLOAD_MODE=api)
STORAGE_BUCKET=migration-platform-dev
STORAGE_SSE=AES256
AWS_REGION=eu-west-2
SOURCE_RETENTION_DAYS=30
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
UPLOAD_TOKEN_SECRET=
MAX_UPLOAD_FILE_BYTES=5368709120
