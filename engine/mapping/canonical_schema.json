{
  "_meta": {
    "description": "Universal canonical schema — system-agnostic intermediate layer between any source and any target.",
    "version": "1.0",
    "note": "All IDs are NVARCHAR(50) to remain system-agnostic. Booleans are BIT. Timestamps are DATETIME."
  },
  "entities": {
    "canonical_company": {
      "description": "Any organisation — client, prospect, vendor, partner",
      "fields": {
        "id":                 "NVARCHAR(50)",
        "name":               "NVARCHAR(255)",
        "type":               "NVARCHAR(50)",
        "industry":           "NVARCHAR(255)",
        "website":            "NVARCHAR(255)",
        "background":         "NVARCHAR(MAX)",
        "phone":              "NVARCHAR(50)",
        "email":              "NVARCHAR(50)",
        "fax":                "NVARCHAR(50)",
        "location_id":        "NVARCHAR(50)",
        "invoice_location_id":"NVARCHAR(50)",
        "parent_id":          "NVARCHAR(50)",
        "owner_id":           "NVARCHAR(50)",
        "terms":              "NVARCHAR(255)",
        "reference_no":       "NVARCHAR(50)",
        "division":           "NVARCHAR(50)",
        "notes":              "NVARCHAR(MAX)",
        "created_at":         "DATETIME",
        "updated_at":         "DATETIME",
        "created_by":         "NVARCHAR(50)",
        "updated_by":         "NVARCHAR(50)",
        "is_deleted":         "BIT",
        "is_archived":        "BIT"
      }
    },
    "canonical_contact": {
      "description": "Any individual linked to a company — associate, contact, employee",
