        "role":            "NVARCHAR(50)",
        "contact_type":    "NVARCHAR(50)",
        "position_title":  "NVARCHAR(50)",
        "department_id":   "NVARCHAR(50)",
        "location_id":     "NVARCHAR(50)",
        "company_id":      "NVARCHAR(50)",
        "owner_id":        "NVARCHAR(50)",
        "photo":           "NVARCHAR(MAX)",
        "division_id":     "NVARCHAR(50)",
