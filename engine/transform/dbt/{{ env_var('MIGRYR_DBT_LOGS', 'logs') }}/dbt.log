    COALESCE((SELECT m.survivor FROM "warehouse"."decisions"."merges" m WHERE m.kind = 'contact' AND m.duplicate = s.contact_id), s.contact_id) AS contact_id,
    COALESCE((SELECT m.survivor FROM "warehouse"."decisions"."merges" m WHERE m.kind = 'job' AND m.duplicate = s.job_id), s.job_id) AS job_id,
    s.user_id,
    s.occurred_at,
    s.outcome,
    s.subject
