LEFT JOIN 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/harrow-finch-cobaltdesk-beaconfield/runs/dev/source/Addresses.parquet' AS ad ON ad.AddressID = a.AddressID
LEFT JOIN 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/harrow-finch-cobaltdesk-beaconfield/runs/dev/source/AccountStatus.parquet' AS st ON st.Account_StatusID = a.AccountStatusTypeID
  );

