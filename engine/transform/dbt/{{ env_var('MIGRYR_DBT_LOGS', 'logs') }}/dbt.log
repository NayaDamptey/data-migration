LEFT JOIN 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Addresses.parquet' AS ad ON ad.AddressID = a.AddressID
LEFT JOIN 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/AccountStatus.parquet' AS st ON st.Account_StatusID = a.AccountStatusTypeID
  );

