    create  table
      "warehouse"."mid"."Jobs__dbt_tmp"
  
    
    as (
      
SELECT
    s.job_id,
    COALESCE((SELECT m.survivor FROM "warehouse"."decisions"."merges" m WHERE m.kind = 'client' AND m.duplicate = s.client_id), s.client_id) AS client_id,
    COALESCE((SELECT m.survivor FROM "warehouse"."decisions"."merges" m WHERE m.kind = 'contact' AND m.duplicate = s.contact_id), s.contact_id) AS contact_id,
    s.title,
    s.employment_type,
    s.salary_min,
    s.salary_max,
    s.rate,
    s.rate_unit,
    s.location,
    s.status,
    s.owner_user_id,
    s.opened_at,
    s.closed_at,
    s.description
FROM "warehouse"."staging"."stg_jobs" s
WHERE s.job_id NOT IN (SELECT duplicate FROM "warehouse"."decisions"."merges" WHERE kind = 'job')
    );
    
  
