    TRY_CAST(r.Req_Description AS VARCHAR) AS description
FROM 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Req.parquet' AS r
LEFT JOIN LATERAL (SELECT rr.BillRate, rr.Salary FROM 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Req_Rates.parquet' AS rr WHERE rr.Req_ID = r.ReqID ORDER BY rr.Req_RateID NULLS FIRST LIMIT 1) AS rt ON TRUE
