    TRY_CAST(CASE WHEN a.stage IN ('placed', 'rejected') OR a.deleted = 1 THEN 0 ELSE 1 END AS BOOLEAN) AS Active
FROM "warehouse"."mid"."Applications" AS a
WHERE (EXISTS(SELECT 1 FROM "warehouse"."mid"."Jobs" AS x WHERE x.job_id = a.job_id AND NOT x.client_id IS NULL))
