    TRY_CAST(iv.created_at AS TIMESTAMP) AS AddedAt
FROM "warehouse"."mid"."Interviews" AS iv
WHERE (EXISTS(SELECT 1 FROM "warehouse"."mid"."Candidates" AS x WHERE x.candidate_id = iv.candidate_id))
    );
    
  
