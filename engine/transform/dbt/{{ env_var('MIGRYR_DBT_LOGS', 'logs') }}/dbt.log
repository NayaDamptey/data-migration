FROM 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Schedule.parquet' AS sc
LEFT JOIN LATERAL (SELECT MIN(s.AssociateID) AS AssociateID FROM 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Associates.parquet' AS s WHERE s.Person_ID = sc.Person_ID) AS ct ON TRUE
  );

