    create  table
      "warehouse"."mid"."Consents__dbt_tmp"
  
    
    as (
      -- generated: the middle tier for Marketing consent, with the reviewer's duplicate merges applied

SELECT
    s.consent_id,
    COALESCE((SELECT m.survivor FROM "warehouse"."decisions"."merges" m WHERE m.kind = 'candidate' AND m.duplicate = s.person_id), s.person_id) AS person_id,
    s.email_ok,
    s.phone_ok,
    s.text_ok,
    s.added_by,
    s.created_at,
    s.updated_at
FROM "warehouse"."staging"."stg_consents" s
QUALIFY ROW_NUMBER() OVER (PARTITION BY COALESCE((SELECT m.survivor FROM "warehouse"."decisions"."merges" m WHERE m.kind = 'candidate' AND m.duplicate = s.person_id), s.person_id) ORDER BY CASE WHEN s.person_id IN (SELECT survivor FROM "warehouse"."decisions"."merges") THEN 0 ELSE 1 END, s.consent_id) = 1
    );
    
  
