UNION ALL
SELECT 'Deal_Stage' AS target_table, CAST(TRY_CAST(pl.placement_id AS INT) AS VARCHAR) AS source_key, 'rejected' AS action, 'not a migrated candidate (a contact, a removed duplicate or missing)' AS reason
