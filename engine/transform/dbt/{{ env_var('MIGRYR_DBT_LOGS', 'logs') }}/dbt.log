    create  table
      "warehouse"."target"."Invoice__dbt_tmp"
  
    
    as (
      -- generated from spec/target.yml: middle tier -> Invoice

SELECT
    TRY_CAST(TRY_CAST(inv.invoice_id AS INT) AS INTEGER) AS ID,
    TRY_CAST(inv.invoice_type AS VARCHAR) AS Type,
