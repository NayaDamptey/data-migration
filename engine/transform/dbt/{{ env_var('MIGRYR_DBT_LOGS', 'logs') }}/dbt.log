    create  table
      "warehouse"."target"."Deal_Stage__dbt_tmp"
  
    
    as (
      
SELECT
    TRY_CAST(TRY_CAST(pl.placement_id AS INT) AS INTEGER) AS ID,
    TRY_CAST(TRY_CAST(pl.placement_id AS INT) AS INTEGER) AS DealID,
    TRY_CAST('Won' AS VARCHAR) AS Stage
FROM "warehouse"."mid"."Placements" AS pl
WHERE (EXISTS(SELECT 1 FROM "warehouse"."mid"."Jobs" AS x WHERE x.job_id = pl.job_id AND NOT x.client_id IS NULL))
