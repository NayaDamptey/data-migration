    TRY_CAST(ad.City AS VARCHAR) AS city,
    TRY_CAST(ad.ZipCode AS VARCHAR) AS postcode,
    TRY_CAST(ad.Country AS VARCHAR) AS country,
    TRY_CAST(CASE WHEN a.Deleted = 1 THEN 'deleted' ELSE LOWER(st.Description) END AS VARCHAR) AS status,
    TRY_CAST(a.CreatedBy AS VARCHAR) AS owner_user_id,
    TRY_CAST(a.CreatedAt AS TIMESTAMP) AS created_at
FROM 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Accounts.parquet' AS a
LEFT JOIN 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/Addresses.parquet' AS ad ON ad.AddressID = a.AddressID
LEFT JOIN 'C:/Users/nayad/Desktop/migration-platform/migration-platform/storage/projects/ci-test/runs/baseline/source/AccountStatus.parquet' AS st ON st.Account_StatusID = a.AccountStatusTypeID
  );

