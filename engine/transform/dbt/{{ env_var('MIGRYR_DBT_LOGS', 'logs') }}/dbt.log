    TRY_CAST(c.added_by AS VARCHAR) AS AddedBy
FROM "warehouse"."mid"."Consents" AS c
WHERE (c.person_id IN (SELECT candidate_id FROM "warehouse"."mid"."Candidates"))
    );
    
  
