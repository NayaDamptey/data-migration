FROM "warehouse"."mid"."Applications" AS a
WHERE (a.stage IN ('offer', 'placed'))
  AND (EXISTS(SELECT 1 FROM "warehouse"."mid"."Jobs" AS x WHERE x.job_id = a.job_id AND NOT x.client_id IS NULL))
  AND (EXISTS(SELECT 1 FROM "warehouse"."mid"."Candidates" AS x WHERE x.candidate_id = a.candidate_id))
    );
    
  
