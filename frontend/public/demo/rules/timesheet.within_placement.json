{"rule":{"id":"timesheet.within_placement","category":"DATE_LOGIC","category_label":"Dates in the wrong order","table":"TimeSheets","key_column":"ID","description":"TimeSheets week outside the contractor's placement dates","sql":"SELECT DISTINCT t.ID, CAST(t.StartDate AS VARCHAR) || ' not in ' || CAST(CAST(h.StartDate AS DATE) AS VARCHAR)\n               || '..' || CAST(CAST(h.EndDate AS DATE) AS VARCHAR)\n        FROM TimeSheets t JOIN TimesheetItems i ON i.Timesheet_ID = t.ID\n        JOIN Req_Hired h ON h.Req_ID = i.Req_ID AND h.Invoiced_PersonID = i.Person_ID\n             AND h.Pipeline_Stage = 'Placed' AND h.Worktype = 'Contract'\n        WHERE t.StartDate < CAST(h.StartDate AS DATE) OR t.Enddate > CAST(h.EndDate AS DATE)"},"total":6,"rows":[{"key":"166","detail":"2022-08-22 not in 2022-06-01..2022-04-07","record":{"ID":"166","Timesheet_TypeID":"4","PONo":"PO00007","Payrate":"0.00","Billrate":"0.00","StartDate":"2022-08-22","Enddate":"2022-08-28","Status":"Submitted","Approved_Date":null,"Approved_By":null}},{"key":"4","detail":"2022-07-18 not in 2022-06-01..2022-04-07","record":{"ID":"4","Timesheet_TypeID":"4","PONo":"PO00007","Payrate":"0.00","Billrate":"0.00","StartDate":"2022-07-18","Enddate":"2022-07-24","Status":"Submitted","Approved_Date":null,"Approved_By":null}},{"key":"143","detail":"2022-08-15 not in 2022-06-01..2022-04-07","record":{"ID":"143","Timesheet_TypeID":"1","PONo":"PO00007","Payrate":"68.65","Billrate":"87.56","StartDate":"2022-08-15","Enddate":"2022-08-21","Status":"Rejected","Approved_Date":null,"Approved_By":null}},{"key":"95","detail":"2022-08-01 not in 2022-06-01..2022-04-07","record":{"ID":"95","Timesheet_TypeID":"1","PONo":"PO00007","Payrate":"68.65","Billrate":"87.56","StartDate":"2022-08-01","Enddate":"2022-08-07","Status":"Approved","Approved_Date":"2022-08-10 09:00:00","Approved_By":"18"}},{"key":"13","detail":"2022-07-25 not in 2022-06-01..2022-04-07","record":{"ID":"13","Timesheet_TypeID":"2","PONo":"PO00007","Payrate":"102.98