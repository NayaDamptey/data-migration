{"rule":{"id":"dup.person","category":"DUPLICATE_PERSON","category_label":"Duplicate people","table":"Person","key_column":"Person_ID","description":"Duplicate Person rows: name variant (nickname/typo) with matching or missing DOB","sql":"SELECT DISTINCT p2.Person_ID, 'duplicate of ' || p1.Person_ID FROM Person p1 JOIN Person p2 ON p1.Person_ID < p2.Person_ID AND (\n       (lower(p1.Last_Name) = lower(p2.Last_Name) AND p1.DOB = p2.DOB\n        AND jaro_winkler_similarity(lower(p1.First_Name), lower(p2.First_Name)) >= 0.75)\n    OR (lower(p1.First_Name) = lower(p2.First_Name) AND p1.DOB = p2.DOB\n        AND damerau_levenshtein(lower(p1.Last_Name), lower(p2.Last_Name)) <= 2)\n    OR (lower(p1.First_Name) = lower(p2.First_Name) AND lower(p1.Last_Name) = lower(p2.Last_Name)\n        AND (p1.DOB IS NULL OR p2.DOB IS NULL OR (day(p1.DOB) = month(p2.DOB) AND month(p1.DOB) = day(p2.DOB)))))"},"total":12,"rows":[{"key":"10005","detail":"duplicate of 370","record":{"Person_ID":"10005","First_Name":"Yusuf","Middle_name":"Hassan","Last_Name":"Haddad","DOB":null,"Account_Number":null,"GDPRConsent_ID":null,"AddressID":"320","DeptID":"1","Role_ID":"3","CreatedAt":"2022-02-14 11:00:00","UpdatedAt":"2024-02-14 15:30:00","CreatedBy":"3","UpdatedBy":"3","Associate":"0","Emp":"0","Deleted":"0","IsArchived":"0"}},{"key":"10011","detail":"duplicate of 446","record":{"Person_ID":"10011","First_Name":"Mike","Middle_name":"David","Last_Name":"Chen","DOB":"1982-11-25","Account_Number":null,"GDPRConsent_ID":null,"AddressID":"396","DeptID":"3","Role_ID":"3","CreatedAt":"2022-02-14 11:00:00","UpdatedAt":"2023-09-19 13:15:00","CreatedBy":"1","UpdatedBy":"3","Associate":"0","Emp":"0","Deleted":"0","IsArchived":"0"}},{"key":"10002","detail":"duplicate of 34","record":{"Person_ID":"10002","First_Name":"Mohammed","Middle_name":"Akhtar","Last_Name":"Hassan","DOB":"1989-12-03","Account_Number":null,"GDPRConsent_ID":null,"AddressID":null,"DeptID":"3","Role_ID":"2","CreatedAt":"2022-02-14 11:00:00","Up